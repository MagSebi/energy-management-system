    {
      "name": "GET \u2013 List devices (200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/{{resource}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{resource}}"
          ]
        }
      }
    },
    {
      "name": "POST \u2013 Create device (201) [valid]",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Smart Plug\",\n  \"maxConsumption\": 150.5,\n  \"description\": \"Living room plug\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/{{resource}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{resource}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Created', ()=> pm.response.to.have.status(201));",
              "let id = null;",
              "const loc = pm.response.headers.get('Location');",
              "if (loc) { id = loc.split('/').slice(-1)[0]; }",
              "else {",
              "  try {",
              "    const body = pm.response.json();",
              "    if (typeof body === 'string') id = body;",
              "    else if (body && body.id) id = body.id;",
              "  } catch(e) {}",
              "}",
              "pm.expect(id, 'Extracted deviceId').to.be.ok;",
              "pm.collectionVariables.set('deviceId', id);"
            ]
          }
        }
      ]
    },
