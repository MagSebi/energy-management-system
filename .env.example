# Energy Management System - Environment Configuration Template
# Copy this file to .env and fill in your values

# ===== AI-Driven Customer Support (Optional) =====
# Set to "disabled" to use only rule-based chatbot
# Set to "openai" or "mistral" to enable AI responses
AI_API_TYPE=disabled

# Your API key for the selected AI provider
# Only required if AI_API_TYPE is set to "openai" or "mistral"
AI_API_KEY=

# ===== Monitoring Configuration =====
# Threshold (in kWh) for overconsumption alerts
# Default: 50 kWh per hour
OVERCONSUMPTION_THRESHOLD=50

# ===== RabbitMQ Configuration =====
# Usually no need to change these when using Docker Compose
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ===== Database Configuration =====
# PostgreSQL credentials (usually no need to change for Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root

# ===== Usage Instructions =====
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and set your AI_API_KEY if you want AI support
# 3. Run: docker compose up --build
#
# To enable OpenAI:
#   AI_API_TYPE=openai
#   AI_API_KEY=sk-your-openai-key-here
#
# To enable Mistral:
#   AI_API_TYPE=mistral
#   AI_API_KEY=your-mistral-key-here
